{
  "name": "meeting-room-booking",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for the multi-tenant meeting room booking POC",
  "packageManager": "pnpm@8.15.5",
  "scripts": {
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
